# AiWave auth environment — copy to .env.local and fill in.
# In production these are provided by the encrypted secret store /
# IntegrationConfig and injected at runtime. NEVER commit real secrets.
#
# Quick start (generates .env.local + a super-admin password):
#   node scripts/gen-secrets.mjs
#
# The app listens on http://localhost:3005. Do not set PORT here — Next.js
# binds the HTTP server before it loads this file. The port is `-p 3005` on
# `npm run dev` / `npm start`, and PORT=3005 in ecosystem.config.js.

# HMAC key used to sign session cookies (>= 16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional seeded super-admin. The password is stored ONLY as a scrypt hash
# (format: scrypt:<saltHex>:<hashHex>) — never in plaintext, never committed.
# Note the ':' delimiter: a '$' would be eaten by dotenv variable expansion.
SUPERADMIN_EMAIL=admin@aiwave.ai
SUPERADMIN_NAME=Admin
SUPERADMIN_PASSWORD_HASH=

# MySQL/MariaDB connection string for the "wave-ai" database (port 3306).
# Prisma reads this at connect time (and `prisma migrate deploy` / seed too).
# NEVER commit a real URL. URL-encode special chars in the password (@ → %40).
#   Format: mysql://USER:PASSWORD@HOST:3306/wave-ai
#
# At scale put a pooler (ProxySQL / maxscale) in front and keep connection_limit
# low per Next.js instance.
DATABASE_URL=

# App / brand name. Launcher + first-paint fallback only — the authoritative,
# admin-editable brand name lives in the BrandConfig table (see getBrand()).
APP_NAME=AiWave

# Public site URL (no trailing slash). Used for OAuth redirects.
APP_URL=https://ai.wavegames.online

# Google OAuth (Web application client). Redirect URI must match Console exactly:
#   https://ai.wavegames.online/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ai.wavegames.online/api/auth/google/callback

# ---------------------------------------------------------------------------
# Generation providers
#
# Which vendors may serve a generation, in preference order. A provider is only
# used when it is listed here AND its key is set AND it has active rows in the
# `model_prices` table — the cheapest capable row wins, so price (data), not
# code, decides who runs a job. Removing a vendor = drop it from this list and
# set `active = false` on its price rows; no deploy needed.
AI_PROVIDER_ORDER=kie,xai

# Kie.ai (primary today — cheapest price rows). NEVER commit a real key.
KIE_API_KEY=
# Optional override; defaults to https://api.kie.ai
KIE_BASE_URL=

# xAI direct (fallback: priced above Kie, used when Kie fails). It reports the
# real job cost in usage.cost_in_usd_ticks, which is what the ledger settles on.
XAI_API_KEY=
# Optional override; defaults to https://api.x.ai
XAI_BASE_URL=

# ---------------------------------------------------------------------------
# Reference-image uploads (POST /api/ai/uploads)
#
# Which object-store driver serves uploads. "local" writes to UPLOAD_DIR; add a
# bucket driver in src/lib/storage/ and name it here to move off the disk. An
# unknown value fails CLOSED (uploads return 503) rather than silently writing
# to the local disk.
STORAGE_DRIVER=local

# Where the local driver writes. Defaults to <repo>/.uploads (gitignored, and
# untouched by `git pull`, so it survives a deploy). Use an absolute path on a
# volume you actually want this on.
UPLOAD_DIR=

# How long an issued reference URL stays valid, in minutes (5-1440, default
# 120). It is baked into the URL's signature, so shortening it does not
# retroactively expire URLs already handed out.
UPLOAD_TTL_MINUTES=120

# NOTE: a generation provider fetches the reference URL itself, so APP_URL must
# be publicly reachable for reference-conditioned generation to work. On
# localhost the provider cannot fetch it and the job will fail (and be refunded).
